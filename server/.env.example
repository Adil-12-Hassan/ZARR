PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/zarr

# Frontend origin (for CORS + cookies)
CLIENT_URL=http://localhost:3000

# JWT secrets — use two DIFFERENT long random strings in production
JWT_SECRET=replace_with_a_long_random_string_for_users
JWT_ADMIN_SECRET=replace_with_a_different_long_random_string_for_admin

# Token lifetimes
JWT_USER_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=2h

# First admin bootstrap (used once by scripts/createAdmin.js)
ADMIN_BOOTSTRAP_EMAIL=admin@zarr.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_before_running
